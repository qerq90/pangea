POSTGRES_DB=pangea
POSTGRES_USER=pangea
POSTGRES_PASSWORD=changeme

VK_TOKEN=your_vk_token_here

# Секретный ключ Callback API группы (Управление → Работа с API → Callback API →
# «Секретный ключ»). Пока пусто, конкурс активности не считает лайки и
# комментарии: без ключа их легко подделать, а за них дают дублоны.
VK_SECRET=

# Пароль админ-панели («/admin» в личке бота) и выдачи логов по HTTP (GET /logs).
# Пусто — и панель, и логи закрыты для всех.
ADMIN_PASSWORD=

# Робокасса (донат). Пока логин и оба пароля пусты, покупка дублонов у
# Рахадима выключена и экран остаётся заглушкой.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# 1/true — тестовые платежи (IsTest=1); пароли тогда тоже тестовые из кабинета
ROBOKASSA_TEST=false
# Алгоритм подписи — как в технических настройках магазина: md5|sha1|sha256|sha384|sha512
ROBOKASSA_HASH=sha256
# Оферта: показывается на экране подтверждения покупки
ROBOKASSA_OFFER_URL=https://example.com/offer
# Передавать ли состав чека (Receipt). Для самозанятых чек выбивают Робочеки СМЗ.
ROBOKASSA_SEND_RECEIPT=false
# ResultURL (https://<домен>/pay/robokassa/result, POST), SuccessURL и FailURL
# задаются в кабинете Робокассы, а не здесь.
