POSTGRES_DB=pangea
POSTGRES_USER=pangea
POSTGRES_PASSWORD=changeme

VK_TOKEN=your_vk_token_here

# Пароль админ-панели («/admin» в личке бота). Пусто — панель выключена.
ADMIN_PASSWORD=

# Касса Т-Банка (донат). Пока TBANK_TERMINAL_KEY и TBANK_PASSWORD пусты,
# покупка дублонов у Рахадима выключена и экран остаётся заглушкой.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
# Вебхук со статусами платежей: HTTPS-адрес этого приложения + /pay/tbank/notify
TBANK_NOTIFICATION_URL=https://example.com/pay/tbank/notify
# Куда банк возвращает браузер игрока — прямо в диалог с сообществом
TBANK_SUCCESS_URL=https://vk.com/im?sel=-000000000
TBANK_FAIL_URL=https://vk.com/im?sel=-000000000
# Оферта: показывается на экране подтверждения покупки
TBANK_OFFER_URL=https://example.com/offer
# Налоговые поля чека — подтвердить с бухгалтерией
TBANK_TAXATION=usn_income
TBANK_TAX=none
TBANK_PAYMENT_OBJECT=service
